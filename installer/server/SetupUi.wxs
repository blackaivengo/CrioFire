<?xml version="1.0" encoding="utf-8"?>
<!--
  Setup wizard: Welcome -> License -> Install folder -> Server options (port) -> Ready -> Finish.
  Based on WixUI_InstallDir from the WiX UI extension, like the CrioFire installer's.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="CrioFireServerUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
      <Property Id="ARPNOMODIFY" Value="1" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- The console's address is made when Finish is clicked, with the port chosen on the Server options page. -->
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixShellExecTarget" Value="https://localhost:[CRIOFIRE_SERVER_PORT]/" Order="997"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenConsole" Order="998"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="CheckTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="3" />
      <!-- The port only on a fresh install; an upgrade keeps the server's settings. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServerSettingsDlg" Order="4" Condition="NOT WIX_UPGRADE_DETECTED" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="WIX_UPGRADE_DETECTED" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="CheckTargetPath" Value="[_BrowseProperty]" Order="1" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SetTargetPath" Value="[_BrowseProperty]" Order="3" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="EndDialog" Value="Return" Order="4" />

      <Publish Dialog="ServerSettingsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="ServerSettingsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg"
               Condition="CRIOFIRE_SERVER_PORT &gt;= 1 AND CRIOFIRE_SERVER_PORT &lt;= 65535" />
      <Publish Dialog="ServerSettingsDlg" Control="Next" Event="SpawnDialog" Value="PortErrorDlg"
               Condition="NOT (CRIOFIRE_SERVER_PORT &gt;= 1 AND CRIOFIRE_SERVER_PORT &lt;= 65535)" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServerSettingsDlg" Order="1" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>

  <Fragment>
    <UI>
      <Dialog Id="ServerSettingsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Server options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose the port PCs and administrators use to reach this server." />

        <Control Id="PortLabel" Type="Text" X="20" Y="58" Width="100" Height="12" NoPrefix="yes" Text="&amp;Port (HTTPS):" />
        <Control Id="PortEdit" Type="Edit" X="120" Y="55" Width="60" Height="17" Property="CRIOFIRE_SERVER_PORT" Text="{5}" />

        <Control Id="FirewallNote" Type="Text" X="20" Y="86" Width="330" Height="30" NoPrefix="yes"
                 Text="Setup allows this port in Windows Firewall. If another firewall sits between your PCs and this server, allow the port there too." />
        <Control Id="ConsoleNote" Type="Text" X="20" Y="124" Width="330" Height="42" NoPrefix="yes"
                 Text="When setup finishes, the console opens in your browser on this server. The browser warns about the certificate the first time, because the server made it itself: accept it, then create the first administrator." />
        <Control Id="DataNote" Type="Text" X="20" Y="174" Width="330" Height="30" NoPrefix="yes"
                 Text="Uninstalling keeps the server's data (enrolled PCs, policies, administrators), so reinstalling picks up where it left off." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="PortErrorDlg" Width="260" Height="85" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="220" Height="30" NoPrefix="yes" Text="Enter a port number from 1 to 65535 (7443 unless you need another)." />
        <Control Id="OK" Type="PushButton" X="97" Y="57" Width="66" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
