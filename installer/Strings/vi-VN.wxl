  <String Id="OutOfDiskDlgText" Value="Các ổ đĩa được tô sáng không đủ dung lượng trống cho các tính năng đang chọn. Bạn có thể xóa bớt tệp trên các ổ đĩa đó, cài ít tính năng hơn hoặc chọn ổ đĩa đích khác." />
  <String Id="OutOfDiskDlgDescription" Value="Dung lượng đĩa cần để cài đặt vượt quá dung lượng còn trống." />
  <String Id="OutOfDiskDlgTitle" Value="{\WixUI_Font_Title}Hết dung lượng đĩa" />
  <String Id="OutOfRbDiskDlgText" Value="Các ổ đĩa được tô sáng không đủ dung lượng trống cho các tính năng đang chọn. Bạn có thể xóa bớt tệp trên các ổ đĩa đó, cài ít tính năng hơn hoặc chọn ổ đĩa đích khác." />
  <String Id="OutOfRbDiskDlgDescription" Value="Dung lượng đĩa cần để cài đặt vượt quá dung lượng còn trống." />
  <String Id="OutOfRbDiskDlgTitle" Value="{\WixUI_Font_Title}Hết dung lượng đĩa" />
  <String Id="OutOfRbDiskDlgText2" Value="Ngoài ra, bạn có thể tắt chức năng khôi phục (rollback) của trình cài đặt. Khi tắt, trình cài đặt sẽ không thể đưa máy tính về trạng thái ban đầu nếu quá trình cài đặt bị gián đoạn. Bấm Có nếu bạn chấp nhận rủi ro khi tắt chức năng này." />
