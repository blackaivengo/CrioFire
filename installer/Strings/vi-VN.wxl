  <String Id="MaintenanceTypeDlgRepairText" Value="Sửa lỗi trong lần cài đặt gần nhất bằng cách khôi phục các tệp, lối tắt và mục registry bị thiếu hoặc hỏng." />
  <String Id="MaintenanceTypeDlgRepairDisabledText" Value="Không thể sửa chữa [ProductName]." />
  <String Id="MaintenanceWelcomeDlgDescription" Value="Trình hướng dẫn cài đặt cho phép bạn thay đổi cách cài các tính năng của [ProductName] trên máy tính hoặc gỡ bỏ nó khỏi máy tính. Bấm Tiếp để tiếp tục hoặc Hủy để thoát Trình hướng dẫn cài đặt." />
  <String Id="MaintenanceWelcomeDlgTitle" Value="{\WixUI_Font_Bigger}Chào mừng đến với Trình hướng dẫn cài đặt [ProductName]" />
  <String Id="MsiRMFilesInUseText" Value="Các ứng dụng sau đang dùng những tệp mà bản cài đặt này cần cập nhật. Bạn có thể để Trình hướng dẫn cài đặt đóng chúng và thử khởi động lại, hoặc khởi động lại máy tính sau." />
