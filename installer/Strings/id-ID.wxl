  <String Id="ModeLabel" Value="Saat program tanpa aturan terhubung keluar:" />
  <String Id="ModeLearning" Value="&amp;Belajar: biarkan, dan tunjukkan apa yang terhubung (disarankan di awal)" />
  <String Id="ModeAsk" Value="&amp;Tanya: blokir dan tanyakan apakah saya mengizinkannya" />
  <String Id="ModeAllowlist" Value="&amp;Hanya daftar izin: blokir tanpa bertanya" />
  <String Id="AllowRunning" Value="Izinkan program yang sedang be&amp;rjalan sekarang (disarankan)" />
  <String Id="Autostart" Value="&amp;Jalankan CrioFire di area notifikasi saat siapa pun masuk" />
  <String Id="ServiceNote" Value="Layanan CrioFire dimulai bersama Windows dan tetap melindungi Anda meski aplikasi ditutup. Mode Tanya hanya bisa bertanya saat aplikasi berjalan. Menghapus CrioFire juga menghapus semua aturannya." />

