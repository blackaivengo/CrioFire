<WixLocalization Culture="bn-BD" Codepage="65001" SummaryInformationCodepage="1252" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="CrioFireFont" Value="Nirmala UI" />
  <String Id="DowngradeError" Value="[ProductName]-এর একটি নতুন সংস্করণ আগে থেকেই ইনস্টল করা আছে।" />
  <String Id="NeedsWindows64" Value="CrioFire Private Firewall-এর জন্য 64-বিট Windows লাগে। Windows 10 ও Windows 11 সমর্থিত।" />
  <String Id="OpenNow" Value="এখনই CrioFire Private Firewall খুলুন" />
  <String Id="ServiceDescription" Value="Windows Filtering Platform-এর মাধ্যমে CrioFire Private Firewall-এর নিয়ম প্রয়োগ করে।" />
  <String Id="ShortcutDescription" Value="দেখুন কে নেটওয়ার্কের সঙ্গে কথা বলে, এবং অনুমতি দিন বা ব্লক করুন" />
  <String Id="OptionsTitle" Value="সেটআপের বিকল্প" />
  <String Id="OptionsDescription" Value="CrioFire কীভাবে চালু হবে বেছে নিন। পরে অ্যাপে সব বদলাতে পারবেন।" />
  <String Id="ModeLabel" Value="নিয়মহীন কোনো প্রোগ্রাম বাইরে সংযোগ করলে:" />
  <String Id="ModeLearning" Value="শেখা(&amp;L): যেতে দিন, আর কী সংযোগ করে দেখান (শুরুতে প্রস্তাবিত)" />
  <String Id="ModeAsk" Value="জিজ্ঞাসা(&amp;A): ব্লক করুন এবং অনুমতি দেব কিনা আমাকে জিজ্ঞেস করুন" />
  <String Id="ModeAllowlist" Value="শুধু অনুমতি তালিকা(&amp;O): জিজ্ঞেস না করেই ব্লক করুন" />
  <String Id="AllowRunning" Value="এখন চলমান প্রোগ্রামগুলোকে অনুমতি দিন(&amp;W) (প্রস্তাবিত)" />
  <String Id="Autostart" Value="কেউ সাইন ইন করলে বিজ্ঞপ্তি এলাকায় CrioFire চালু করুন(&amp;S)" />
  <String Id="ServiceNote" Value="CrioFire সেবা Windows-এর সঙ্গে চালু হয় এবং অ্যাপ বন্ধ থাকলেও আপনাকে সুরক্ষা দিতে থাকে। জিজ্ঞাসা মোড শুধু অ্যাপ চলার সময় জিজ্ঞেস করতে পারে। CrioFire আনইনস্টল করলে এর সব নিয়ম মুছে যায়।" />

