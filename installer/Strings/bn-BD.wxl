  <String Id="ResumeDlgDescription" Value="সেটআপ উইজার্ড আপনার কম্পিউটারে [ProductName]-এর ইনস্টলেশন শেষ করবে। চালিয়ে যেতে &#x27;ইনস্টল&#x27;, আর সেটআপ উইজার্ড থেকে বের হতে &#x27;বাতিল&#x27; ক্লিক করুন।" />
