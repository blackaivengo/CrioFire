  <String Id="CancelDlgText" Value="আপনি কি নিশ্চিত যে [ProductName]-এর ইনস্টলেশন বাতিল করতে চান?" />
  <String Id="CancelDlgIconTooltip" Value="তথ্য আইকন" />
  <String Id="DiskCostDlgText" Value="চিহ্নিত ড্রাইভগুলোতে নির্বাচিত বৈশিষ্ট্যের জন্য যথেষ্ট জায়গা নেই। আপনি চিহ্নিত ড্রাইভ থেকে কিছু ফাইল সরাতে, কম বৈশিষ্ট্য ইনস্টল করতে, বা অন্য গন্তব্য ড্রাইভ বেছে নিতে পারেন।" />
  <String Id="DiskCostDlgDescription" Value="নির্বাচিত বৈশিষ্ট্য ইনস্টল করতে যতটা ডিস্কের জায়গা লাগবে।" />
  <String Id="DiskCostDlgTitle" Value="{\WixUI_Font_Title}ডিস্কের জায়গার প্রয়োজন" />
  <String Id="ErrorDlgErrorIconTooltip" Value="তথ্য আইকন" />
  <String Id="ExitDialogDescription" Value="সেটআপ উইজার্ড থেকে বের হতে শেষ বোতামে ক্লিক করুন।" />
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}[ProductName] সেটআপ উইজার্ড সম্পন্ন হয়েছে" />
  <String Id="FatalErrorTitle" Value="{\WixUI_Font_Bigger}[ProductName] সেটআপ উইজার্ড আগেই থেমে গেছে" />
  <String Id="FatalErrorDescription1" Value="একটি ত্রুটির কারণে [ProductName] সেটআপ উইজার্ড আগেই থেমে গেছে। আপনার সিস্টেমে কোনো পরিবর্তন হয়নি। পরে এই প্রোগ্রামটি ইনস্টল করতে আবার সেটআপ উইজার্ড চালান।" />
  <String Id="FatalErrorDescription2" Value="সেটআপ উইজার্ড থেকে বের হতে শেষ বোতামে ক্লিক করুন।" />
  <String Id="FilesInUseExit" Value="বের হন(&amp;X)" />
  <String Id="FilesInUseText" Value="নিচের অ্যাপগুলো এমন ফাইল ব্যবহার করছে যা এই সেটআপকে আপডেট করতে হবে। অ্যাপগুলো বন্ধ করে সেটআপ চালিয়ে যেতে &#x27;আবার চেষ্টা&#x27; বা বের হতে &#x27;বের হন&#x27; ক্লিক করুন।" />
  <String Id="FilesInUseDescription" Value="আপডেট করতে হবে এমন কিছু ফাইল এখন ব্যবহৃত হচ্ছে।" />
  <String Id="FilesInUseTitle" Value="{\WixUI_Font_Title}ফাইল ব্যবহৃত হচ্ছে" />
  <String Id="InstallDirDlgChange" Value="বদলান(&amp;C)..." />
  <String Id="InstallDirDlgTitle" Value="{\WixUI_Font_Title}গন্তব্য ফোল্ডার" />
  <String Id="InstallDirDlgDescription" Value="ডিফল্ট ফোল্ডারে ইনস্টল করতে &#x27;পরবর্তী&#x27; ক্লিক করুন, অথবা অন্যটি বেছে নিতে &#x27;বদলান&#x27; ক্লিক করুন।" />
  <String Id="InstallDirDlgFolderLabel" Value="[ProductName] এখানে ইনস্টল করুন:" />
  <String Id="InvalidDirDlgText" Value="ইনস্টলেশন ফোল্ডার অবশ্যই কোনো স্থানীয় হার্ড ড্রাইভে থাকতে হবে।" />
  <String Id="InvalidDirDlgIconTooltip" Value="তথ্য আইকন" />
  <String Id="LicenseAgreementDlgLicenseAcceptedCheckBox" Value="আমি লাইসেন্স চুক্তির শর্তাবলি মেনে নিচ্ছি(&amp;A)" />
  <String Id="LicenseAgreementDlgDescription" Value="অনুগ্রহ করে নিচের লাইসেন্স চুক্তিটি মনোযোগ দিয়ে পড়ুন" />
  <String Id="LicenseAgreementDlgTitle" Value="{\WixUI_Font_Title}ব্যবহারকারীর লাইসেন্স চুক্তি" />
  <String Id="MaintenanceTypeDlgChangeButton" Value="বদলান(&amp;C)" />
  <String Id="MaintenanceTypeDlgChangeButtonTooltip" Value="ইনস্টলেশন বদলান" />
  <String Id="MaintenanceTypeDlgRepairButton" Value="মেরামত(&amp;P)" />
  <String Id="MaintenanceTypeDlgRepairButtonTooltip" Value="ইনস্টলেশন মেরামত করুন" />
  <String Id="MaintenanceTypeDlgRemoveButton" Value="সরান(&amp;R)" />
  <String Id="MaintenanceTypeDlgRemoveButtonTooltip" Value="ইনস্টলেশন সরান" />
  <String Id="MaintenanceTypeDlgDescription" Value="আপনি কোন কাজটি করতে চান বেছে নিন।" />
  <String Id="MaintenanceTypeDlgTitle" Value="{\WixUI_Font_Title}ইনস্টলেশন বদলান, মেরামত করুন বা সরান" />
  <String Id="MaintenanceTypeDlgChangeText" Value="বৈশিষ্ট্যগুলো কীভাবে ইনস্টল হবে তা বদলাতে দেয়।" />
  <String Id="MaintenanceTypeDlgChangeDisabledText" Value="[ProductName]-এ আলাদাভাবে বেছে নেওয়ার মতো কোনো বৈশিষ্ট্য নেই।" />
  <String Id="MaintenanceTypeDlgRemoveText" Value="আপনার কম্পিউটার থেকে [ProductName] সরায়।" />
  <String Id="MaintenanceTypeDlgRemoveDisabledText" Value="[ProductName] সরানো যাবে না।" />
  <String Id="MaintenanceTypeDlgRepairText" Value="হারানো বা নষ্ট ফাইল, শর্টকাট ও রেজিস্ট্রি এন্ট্রি ঠিক করে সর্বশেষ ইনস্টলেশনের ত্রুটি মেরামত করে।" />
  <String Id="MaintenanceTypeDlgRepairDisabledText" Value="[ProductName] মেরামত করা যাবে না।" />
  <String Id="MaintenanceWelcomeDlgDescription" Value="সেটআপ উইজার্ড দিয়ে আপনি আপনার কম্পিউটারে [ProductName]-এর বৈশিষ্ট্যগুলো কীভাবে ইনস্টল আছে তা বদলাতে বা এটি সরাতে পারেন। চালিয়ে যেতে &#x27;পরবর্তী&#x27;, আর সেটআপ উইজার্ড থেকে বের হতে &#x27;বাতিল&#x27; ক্লিক করুন।" />
  <String Id="MaintenanceWelcomeDlgTitle" Value="{\WixUI_Font_Bigger}[ProductName] সেটআপ উইজার্ডে স্বাগতম" />
  <String Id="MsiRMFilesInUseText" Value="নিচের অ্যাপগুলো এমন ফাইল ব্যবহার করছে যা এই সেটআপকে আপডেট করতে হবে। আপনি সেটআপ উইজার্ডকে এগুলো বন্ধ করে আবার চালু করার চেষ্টা করতে দিতে পারেন, অথবা পরে কম্পিউটার রিস্টার্ট করতে পারেন।" />
  <String Id="MsiRMFilesInUseDescription" Value="আপডেট করতে হবে এমন কিছু ফাইল এখন ব্যবহৃত হচ্ছে।" />
  <String Id="MsiRMFilesInUseTitle" Value="{\WixUI_Font_Title}ফাইল ব্যবহৃত হচ্ছে" />
  <String Id="MsiRMFilesInUseUseRM" Value="অ্যাপগুলো বন্ধ করে আবার চালু করার চেষ্টা করুন(&amp;C)।" />
  <String Id="MsiRMFilesInUseDontUseRM" Value="অ্যাপগুলো বন্ধ করবেন না(&amp;D)। রিস্টার্ট করতে হবে।" />
  <String Id="OutOfDiskDlgText" Value="চিহ্নিত ড্রাইভগুলোতে এখন নির্বাচিত বৈশিষ্ট্যের জন্য যথেষ্ট জায়গা নেই। আপনি চিহ্নিত ড্রাইভ থেকে কিছু ফাইল সরাতে, কম বৈশিষ্ট্য ইনস্টল করতে, বা অন্য গন্তব্য ড্রাইভ বেছে নিতে পারেন।" />
  <String Id="OutOfDiskDlgDescription" Value="ইনস্টলেশনের জন্য প্রয়োজনীয় জায়গা খালি জায়গার চেয়ে বেশি।" />
  <String Id="OutOfDiskDlgTitle" Value="{\WixUI_Font_Title}ডিস্কে জায়গা নেই" />
  <String Id="OutOfRbDiskDlgText" Value="চিহ্নিত ড্রাইভগুলোতে এখন নির্বাচিত বৈশিষ্ট্যের জন্য যথেষ্ট জায়গা নেই। আপনি চিহ্নিত ড্রাইভ থেকে কিছু ফাইল সরাতে, কম বৈশিষ্ট্য ইনস্টল করতে, বা অন্য গন্তব্য ড্রাইভ বেছে নিতে পারেন।" />
  <String Id="OutOfRbDiskDlgDescription" Value="ইনস্টলেশনের জন্য প্রয়োজনীয় জায়গা খালি জায়গার চেয়ে বেশি।" />
  <String Id="OutOfRbDiskDlgTitle" Value="{\WixUI_Font_Title}ডিস্কে জায়গা নেই" />
  <String Id="OutOfRbDiskDlgText2" Value="বিকল্পভাবে, আপনি ইনস্টলারের রোলব্যাক সুবিধা বন্ধ করতে পারেন। রোলব্যাক বন্ধ থাকলে ইনস্টলেশন কোনোভাবে থেমে গেলে ইনস্টলার আপনার কম্পিউটারকে আগের অবস্থায় ফেরাতে পারবে না। রোলব্যাক বন্ধ করার ঝুঁকি নিতে চাইলে &#x27;হ্যাঁ&#x27; ক্লিক করুন।" />
  <String Id="PrepareDlgDescription" Value="সেটআপ উইজার্ড আপনাকে ইনস্টলেশনে সাহায্য করার প্রস্তুতি নিচ্ছে, অনুগ্রহ করে অপেক্ষা করুন।" />
  <String Id="PrepareDlgTitle" Value="{\WixUI_Font_Bigger}[ProductName] সেটআপ উইজার্ডে স্বাগতম" />
