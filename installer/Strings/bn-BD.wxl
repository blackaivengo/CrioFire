  <String Id="UserExitTitle" Value="{\WixUI_Font_Bigger}[ProductName] সেটআপ উইজার্ড মাঝপথে থেমেছে" />
  <String Id="UserExitDescription1" Value="[ProductName] সেটআপ মাঝপথে থেমেছে। আপনার সিস্টেমে কোনো পরিবর্তন হয়নি। পরে এই প্রোগ্রামটি ইনস্টল করতে আবার ইনস্টলেশন চালান।" />
  <String Id="UserExitDescription2" Value="সেটআপ উইজার্ড থেকে বের হতে শেষ বোতামে ক্লিক করুন।" />
