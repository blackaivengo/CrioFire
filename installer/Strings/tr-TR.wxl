  <String Id="ModeAsk" Value="&amp;Sorma: engelle ve izin verilip verilmeyeceğini bana sor" />
  <String Id="ModeAllowlist" Value="&amp;Yalnızca izin listesi: sormadan engelle" />
  <String Id="AllowRunning" Value="Şu anda &amp;çalışan programlara izin ver (önerilir)" />
  <String Id="Autostart" Value="Herhangi biri oturum açtığında CrioFire&#x27;ı bildirim alanında &amp;başlat" />
  <String Id="ServiceNote" Value="CrioFire hizmeti Windows ile başlar ve uygulama kapalıyken bile sizi korumaya devam eder. Sorma modu yalnızca uygulama çalışırken sorabilir. CrioFire kaldırılırsa tüm kuralları da kaldırılır." />
