<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- CrioFire Server: a company's own server for managing CrioFire on its PCs (enrollment, status,
       policies and the admin web console in wwwroot). Runs as the Windows service "criofire-server". -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CrioFire.Server</RootNamespace>
    <AssemblyName>criofire-server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="..\CrioFire.Core\CrioFire.Core.csproj" />
    <InternalsVisibleTo Include="CrioFire.Tests" />
  </ItemGroup>

  <!-- The console is served from the folder the server runs in (it runs as a service), so the files
       go next to the exe on build as well as on publish. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
