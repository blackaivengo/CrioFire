<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- CrioFire Server: a company's own server for managing CrioFire on its PCs (enrollment, status,
       and later policies and the admin console). Runs as the Windows service "criofire-server". -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CrioFire.Server</RootNamespace>
    <AssemblyName>criofire-server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="..\CrioFire.Core\CrioFire.Core.csproj" />
    <InternalsVisibleTo Include="CrioFire.Tests" />
  </ItemGroup>

</Project>
