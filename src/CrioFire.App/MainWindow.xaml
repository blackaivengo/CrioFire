<Window x:Class="CrioFire.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrioFire Private Firewall" Height="480" Width="820"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Rules" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button x:Name="RefreshButton" Content="Refresh" Margin="16,0,0,0" Padding="12,4" Click="OnRefresh" />
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap" />
    <ListView x:Name="RulesList">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Filter ID" Width="100" DisplayMemberBinding="{Binding FilterId}" />
          <GridViewColumn Header="Action" Width="80" DisplayMemberBinding="{Binding Action}" />
          <GridViewColumn Header="Layer" Width="120" DisplayMemberBinding="{Binding Layer}" />
          <GridViewColumn Header="Program" Width="480" DisplayMemberBinding="{Binding Program}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
