<Window x:Class="CrioFire.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrioFire Private Firewall" Width="1360" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal">
  <Grid ClipToBounds="True">
    <!-- Ambient ice and fire light behind the glass panels. -->
    <Ellipse Width="780" Height="780" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-230,-300,0,0"
             Fill="{DynamicResource BlobIceBrush}" IsHitTestVisible="False" />
    <Ellipse Width="840" Height="840" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-280,-340"
             Fill="{DynamicResource BlobFireBrush}" IsHitTestVisible="False" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource NavBorderBrush}" BorderThickness="0,0,1,0" Padding="18,26,18,20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,30">
            <Viewbox Width="40" Height="40">
              <Canvas Width="40" Height="40">
                <Canvas.Effect>
                  <DropShadowEffect Color="#B9A8FF" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.55" />
                </Canvas.Effect>
                <Path Data="{StaticResource LogoFlame}" Fill="{StaticResource BrandBrush}" />
                <Path Data="M14,22 L17,20 L20,22 L23,20 L26,22 M20,16 V30" Stroke="White" Opacity="0.85" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="CrioFire" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="Bold" />
              <TextBlock Text="PRIVATE FIREWALL" Style="{StaticResource Caption}" Foreground="{DynamicResource Text2Brush}" />
            </StackPanel>
          </StackPanel>

          <Border DockPanel.Dock="Bottom" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16">
            <StackPanel>
              <TextBlock Text="Service" Style="{StaticResource Caption}" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                <Ellipse x:Name="ServiceDot" Width="8" Height="8" Fill="{DynamicResource IceBrush}" VerticalAlignment="Center">
                  <Ellipse.Effect>
                    <DropShadowEffect x:Name="ServiceDotGlow" Color="#7DD8FF" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                  </Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="ServiceText" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Text="Connecting..." />
              </StackPanel>
              <Button x:Name="PanicButton" Content="Panic..." Style="{StaticResource OutlineFireButton}" Click="OnPanic"
                      ToolTip="Allow everything, block everything, or remove all rules" />
            </StackPanel>
          </Border>

          <StackPanel>
            <RadioButton x:Name="NavDashboard" Content="Dashboard" Tag="{StaticResource IconDashboard}" Style="{StaticResource NavItem}" Checked="OnNav" />
            <RadioButton x:Name="NavActivity" Content="Activity" Tag="{StaticResource IconActivity}" Style="{StaticResource NavItem}" Checked="OnNav" />
            <RadioButton x:Name="NavRules" Content="Rules" Tag="{StaticResource IconRules}" Style="{StaticResource NavItem}" Checked="OnNav" />
            <RadioButton x:Name="NavConnections" Content="Connections" Tag="{StaticResource IconConnections}" Style="{StaticResource NavItem}" Checked="OnNav" />
            <RadioButton x:Name="NavReports" Content="Reports" Tag="{StaticResource IconReports}" Style="{StaticResource NavItem}" Checked="OnNav" />
            <RadioButton x:Name="NavSettings" Content="Settings" Tag="{StaticResource IconSettings}" Style="{StaticResource NavItem}" Checked="OnNav" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="36,26,36,8">
          <!-- While panic is on, a banner across the top with a one-click way back. -->
          <Border x:Name="PanicBanner" DockPanel.Dock="Top" CornerRadius="12" Padding="16,10" Margin="0,0,0,16" Visibility="Collapsed"
                  Background="{DynamicResource ChipFireBrush}" BorderBrush="{DynamicResource FireBrush}" BorderThickness="1">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Resume my rules" Style="{StaticResource FireButton}" MinHeight="34" Click="OnResume" />
              <Button DockPanel.Dock="Right" Content="Options" Style="{StaticResource GhostButton}" MinHeight="34" Margin="0,0,8,0" Click="OnPanic" />
              <TextBlock x:Name="PanicBannerText" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{DynamicResource ChipFireTextBrush}" Margin="0,0,12,0" />
            </DockPanel>
          </Border>
          <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="0" VerticalAlignment="Top" Click="OnToggleTheme"
                  x:Name="ThemeButton" AutomationProperties.Name="Switch between light and dark mode">
            <Border Style="{StaticResource SegGroup}">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="SunSpot" Width="40" Height="34" CornerRadius="9">
                  <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                      <Path x:Name="SunIcon" Data="{StaticResource IconSun}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                  </Viewbox>
                </Border>
                <Border x:Name="MoonSpot" Width="40" Height="34" CornerRadius="9" Margin="2,0,0,0">
                  <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                      <Path x:Name="MoonIcon" Data="{StaticResource IconMoon}" StrokeThickness="2" StrokeLineJoin="Round" />
                    </Canvas>
                  </Viewbox>
                </Border>
              </StackPanel>
            </Border>
          </Button>
          <ContentControl x:Name="PageActions" DockPanel.Dock="Right" Margin="0,0,14,0" VerticalAlignment="Top" Focusable="False" />
          <StackPanel>
            <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" />
            <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,14,36,40" Focusable="False">
          <ContentControl x:Name="PageHost" Focusable="False" />
        </ScrollViewer>

        <!-- Messages ("Allowed Chat.exe.", service errors) slide in at the bottom. -->
        <Border x:Name="MessageBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                CornerRadius="12" Padding="18,11" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Visibility="Collapsed" MaxWidth="720">
          <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" />
          </Border.Effect>
          <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
