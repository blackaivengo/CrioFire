<UserControl x:Class="CrioFire.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel MaxWidth="900" HorizontalAlignment="Left">
    <ContentControl Style="{StaticResource IceCard}" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Appearance" Style="{StaticResource H2}" />
        <TextBlock Text="Follow Windows, or always use the light or dark look." Style="{StaticResource Muted}" Margin="0,6,0,16" />
        <Border Style="{StaticResource SegGroup}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ThemeSystem" Content="Same as Windows" Tag="system" GroupName="Theme" Style="{StaticResource SegItem}" Click="OnTheme" />
            <RadioButton x:Name="ThemeLight" Content="Light" Tag="light" GroupName="Theme" Style="{StaticResource SegItem}" Click="OnTheme" />
            <RadioButton x:Name="ThemeDark" Content="Dark" Tag="dark" GroupName="Theme" Style="{StaticResource SegItem}" Click="OnTheme" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ContentControl>

    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Startup and notification area" Style="{StaticResource H2}" />
        <TextBlock Text="In Ask mode, CrioFire can only ask about new programs while the app is running." Style="{StaticResource Muted}" Margin="0,6,0,18" />
        <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="OnAutostart" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Start CrioFire when I sign in to Windows" />
            <TextBlock Text="It starts quietly in the notification area, next to the clock." Style="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource Switch}" Click="OnCloseToTray">
          <StackPanel>
            <TextBlock Text="Keep running in the notification area when I close the window" />
            <TextBlock Text="Turn off to exit the app when you close its window. The firewall keeps working either way." Style="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </ContentControl>

    <ContentControl Style="{StaticResource FireCard}" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Recovery" Style="{StaticResource H2}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,16" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                   Text="Something can't connect, or something is connecting that shouldn't? Allow everything with your rules paused, or block all network traffic. Neither deletes a rule, and Resume brings them back. From an administrator prompt: 'criofire panic', 'criofire panic block', 'criofire resume' (they work even when the service is stopped)." />
        <TextBlock x:Name="PanicState" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
        <WrapPanel>
          <Button x:Name="ResumeButton" Content="Resume my rules" Style="{StaticResource IceButton}" Margin="0,0,10,8" Click="OnResume" />
          <Button x:Name="AllowAllButton" Content="Allow everything, pause my rules" Style="{StaticResource OutlineIceButton}" Margin="0,0,10,8" Click="OnAllowAll" />
          <Button x:Name="BlockAllButton" Content="Block all network traffic" Style="{StaticResource OutlineFireButton}" Margin="0,0,10,8" Click="OnBlockAll" />
        </WrapPanel>
      </StackPanel>
    </ContentControl>

    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Networks" Style="{StaticResource H2}" />
        <TextBlock x:Name="NetworksText" Margin="0,6,0,6" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                   Text="Rules can apply on every network, or only on home and work networks (private, domain) or only on public ones. Windows decides which kind each network is: mark your home network as private in Windows' network settings, and leave cafés and hotels public. Right-click a rule on the Rules page and choose Networks." />
        <Button Content="Open Windows network settings" Style="{StaticResource OutlineIceButton}" HorizontalAlignment="Left" Click="OnNetworkSettings" />
      </StackPanel>
    </ContentControl>

    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="License" Style="{StaticResource H2}" />
        <TextBlock x:Name="LicenseText" Margin="0,6,0,6" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                   Text="CrioFire is free for personal use, non-profits, schools, government, and businesses with up to 3 computers. Businesses with more computers need a license for each one; paste the key from your license email here." />
        <DockPanel>
          <Button x:Name="LicenseRemove" DockPanel.Dock="Right" Content="Remove" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnRemoveLicense" />
          <Button DockPanel.Dock="Right" Content="Enter key" Style="{StaticResource IceButton}" Margin="8,0,0,0" Click="OnEnterLicense" />
          <TextBox x:Name="LicenseKeyBox" VerticalContentAlignment="Center" ToolTip="CRIOFIRE1..." />
        </DockPanel>
      </StackPanel>
    </ContentControl>

    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Tamper protection" Style="{StaticResource H2}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,16" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                   Text="Without it, CrioFire's app and command line may change rules for anyone signed in to this PC, so a harmful program running as you could use them to allow itself. With it, every change asks Windows for administrator approval first." />
        <CheckBox x:Name="ProtectionSwitch" Style="{StaticResource Switch}" Click="OnProtection">
          <StackPanel>
            <TextBlock Text="Ask for administrator approval before any rule changes" />
            <TextBlock Text="Turning this on or off needs approval too." Style="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </ContentControl>

    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Connection history" Style="{StaticResource H2}" />
        <TextBlock x:Name="LogsText" Margin="0,6,0,6" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                   Text="CrioFire remembers blocked and allowed connections for the Dashboard, Traffic and Reports. Older connections are removed every hour; when a log reaches its size limit, its oldest half goes." />
        <TextBlock Text="Keep connections for" FontSize="13" Margin="0,0,0,6" />
        <Border Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,0,0,14">
          <StackPanel x:Name="KeepChoices" Orientation="Horizontal">
            <RadioButton Content="7 days" Tag="7" GroupName="LogKeep" Style="{StaticResource SegItem}" Click="OnLogKeep" />
            <RadioButton Content="30 days" Tag="30" GroupName="LogKeep" Style="{StaticResource SegItem}" Click="OnLogKeep" />
            <RadioButton Content="90 days" Tag="90" GroupName="LogKeep" Style="{StaticResource SegItem}" Click="OnLogKeep" />
            <RadioButton Content="1 year" Tag="365" GroupName="LogKeep" Style="{StaticResource SegItem}" Click="OnLogKeep" />
          </StackPanel>
        </Border>
        <TextBlock Text="Each log may use up to" FontSize="13" Margin="0,0,0,6" />
        <Border Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,0,0,16">
          <StackPanel x:Name="SizeChoices" Orientation="Horizontal">
            <RadioButton Content="20 MB" Tag="20" GroupName="LogSize" Style="{StaticResource SegItem}" Click="OnLogSize" />
            <RadioButton Content="50 MB" Tag="50" GroupName="LogSize" Style="{StaticResource SegItem}" Click="OnLogSize" />
            <RadioButton Content="200 MB" Tag="200" GroupName="LogSize" Style="{StaticResource SegItem}" Click="OnLogSize" />
            <RadioButton Content="500 MB" Tag="500" GroupName="LogSize" Style="{StaticResource SegItem}" Click="OnLogSize" />
          </StackPanel>
        </Border>
        <CheckBox x:Name="RecordAllowedSwitch" Style="{StaticResource Switch}" Click="OnRecordAllowed" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Record allowed connections too" />
            <TextBlock Text="Turn off to keep only blocked connections: Traffic and Reports then show blocked connections only." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </CheckBox>
        <Button x:Name="ClearLogsButton" Content="Clear history" Style="{StaticResource OutlineFireButton}" HorizontalAlignment="Left" Click="OnClearLogs"
                ToolTip="Forget every blocked and allowed connection recorded so far" />
      </StackPanel>
    </ContentControl>

    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Rule backups" Style="{StaticResource H2}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                   Text="CrioFire saves your rules automatically when they change, and before every import or 'remove all rules'. The newest 30 are kept. Restoring puts every rule and the mode back exactly as they were; your rules from now are saved as a backup first. To move rules to another PC, use Export and Import on the Rules page." />
        <StackPanel x:Name="BackupList" />
      </StackPanel>
    </ContentControl>

    <ContentControl Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="About" Style="{StaticResource H2}" />
        <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="14" LineHeight="22" />
      </StackPanel>
    </ContentControl>
  </StackPanel>
</UserControl>
