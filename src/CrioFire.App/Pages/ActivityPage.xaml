<UserControl x:Class="CrioFire.App.Pages.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <!-- What to show -->
    <WrapPanel Margin="0,0,0,10">
      <Border Style="{StaticResource SegGroup}" Margin="0,0,12,8">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="KindBlocked" Content="Blocked" GroupName="Kind" Style="{StaticResource SegFireItem}" IsChecked="True" Click="OnFilterChanged" />
          <RadioButton x:Name="KindAllowed" Content="Allowed" GroupName="Kind" Style="{StaticResource SegIceItem}" Click="OnFilterChanged" />
          <RadioButton x:Name="KindAll" Content="Both" GroupName="Kind" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SegGroup}" Margin="0,0,12,8">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="WindowHour" Content="1 hour" GroupName="Window" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
          <RadioButton x:Name="WindowDay" Content="24 hours" GroupName="Window" Style="{StaticResource SegItem}" IsChecked="True" Click="OnFilterChanged" />
          <RadioButton x:Name="WindowWeek" Content="7 days" GroupName="Window" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
          <RadioButton x:Name="WindowMonth" Content="30 days" GroupName="Window" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SegGroup}" Margin="0,0,12,8">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="DirAny" Content="In and out" GroupName="Dir" Style="{StaticResource SegItem}" IsChecked="True" Click="OnFilterChanged" />
          <RadioButton x:Name="DirOut" Content="Outbound" GroupName="Dir" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
          <RadioButton x:Name="DirIn" Content="Inbound" GroupName="Dir" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
        </StackPanel>
      </Border>
    </WrapPanel>

    <WrapPanel Margin="0,0,0,14">
      <Border Style="{StaticResource SegGroup}" Margin="0,0,12,8">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="WhyAll" Content="Any reason" GroupName="Why" Style="{StaticResource SegItem}" IsChecked="True" Click="OnFilterChanged" />
          <RadioButton x:Name="WhyMine" Content="Your rules" Tag="mine" GroupName="Why" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
          <RadioButton x:Name="WhyNoRule" Content="No rule" Tag="norule" GroupName="Why" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
          <RadioButton x:Name="WhyAuto" Content="Automatic" Tag="automatic" GroupName="Why" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
          <RadioButton x:Name="WhyLocal" Content="Local only" Tag="loopback" GroupName="Why" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
          <RadioButton x:Name="WhyPanic" Content="Panic" Tag="panic" GroupName="Why" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SegGroup}" Margin="0,0,12,8">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="SortRecent" Content="Latest first" GroupName="Sort" Style="{StaticResource SegItem}" IsChecked="True" Click="OnFilterChanged" />
          <RadioButton x:Name="SortCount" Content="Most first" GroupName="Sort" Style="{StaticResource SegItem}" Click="OnFilterChanged" />
        </StackPanel>
      </Border>
      <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Width="280" Margin="0,0,12,8" TextChanged="OnSearchChanged"
               ToolTip="Program, service, address or port. Every word must match." />
      <CheckBox x:Name="LocalSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0,0,12,8" Click="OnFilterChanged"
                ToolTip="Traffic between programs on this PC (127.0.0.1, ::1) is always allowed.">
        <TextBlock Text="Show local (loopback)" VerticalAlignment="Center" />
      </CheckBox>
      <Border x:Name="ScopeChip" Style="{StaticResource Chip}" Background="{DynamicResource ChipIceBrush}" Margin="0,0,0,8" Visibility="Collapsed" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="ScopeText" FontSize="12" Foreground="{DynamicResource ChipIceTextBrush}" VerticalAlignment="Center" />
          <Button Content="✕" Style="{StaticResource GhostButton}" MinHeight="20" Padding="8,0,0,0" FontSize="11" Click="OnClearScope" ToolTip="Show every program again" />
        </StackPanel>
      </Border>
    </WrapPanel>

    <!-- What to do with the selection -->
    <DockPanel Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Allow" Style="{StaticResource IceButton}" Margin="0,0,10,0" Click="OnAllow"
                ToolTip="Allow the selected programs and services (for blocked rows: unblock them)" />
        <Button Content="Allow for 1 hour" Style="{StaticResource OutlineIceButton}" Margin="0,0,10,0" Click="OnAllowHour" />
        <Button Content="Block" Style="{StaticResource FireButton}" Click="OnBlock" ToolTip="Block the selected programs and services" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="↻ Refresh" Style="{StaticResource GhostButton}" MinHeight="32" Padding="0,0,14,0" Click="OnRefresh" ToolTip="Load the latest connections" />
        <Button Content="Select page" Style="{StaticResource GhostButton}" MinHeight="32" Padding="0,0,14,0" Click="OnSelectPage" />
        <TextBlock x:Name="SelectionText" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Ctrl or Shift selects several rows." />
      </StackPanel>
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <ContentControl Style="{StaticResource Card}" Margin="0,0,10,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock x:Name="Empty" Style="{StaticResource Muted}" Visibility="Collapsed" TextWrapping="Wrap" />
          <ListView x:Name="Table" SelectionMode="Extended" SelectionChanged="OnSelectionChanged" MaxHeight="620">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="LAST" Width="92" DisplayMemberBinding="{Binding Time}" />
                <GridViewColumn Header="COUNT" Width="64" DisplayMemberBinding="{Binding CountText}" />
                <GridViewColumn Header="WHY" Width="200">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Chip}" Margin="0" Padding="9,3" Background="{Binding ChipBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Why}" FontSize="12" Foreground="{Binding ChipTextBrush}" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="DIR" Width="52" DisplayMemberBinding="{Binding Direction}" />
                <GridViewColumn Header="REMOTE" Width="210">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel ToolTip="{Binding Remote}">
                        <TextBlock Text="{Binding Remote}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PortName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="PROGRAM OR SERVICE" Width="260">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel ToolTip="{Binding Detail}">
                        <TextBlock Text="{Binding Program}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <DockPanel Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="PrevButton" Content="‹ Previous" Style="{StaticResource OutlineIceButton}" MinHeight="34" Margin="0,0,8,0" Click="OnPrev" />
              <Button x:Name="NextButton" Content="Next ›" Style="{StaticResource OutlineIceButton}" MinHeight="34" Click="OnNext" />
            </StackPanel>
            <TextBlock x:Name="PageText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </ContentControl>

      <!-- Everything known about the selected row -->
      <ContentControl Grid.Column="1" Style="{StaticResource IceCard}" Margin="10,0,0,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock x:Name="DetailEmpty" Style="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="Select a row to see the program, the destination and port, why it was blocked or allowed, and the rules that apply." />
          <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
            <TextBlock x:Name="DetailTitle" Style="{StaticResource H2}" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailPath" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Border x:Name="DetailChip" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,10,0,0">
              <TextBlock x:Name="DetailWhy" FontSize="12" />
            </Border>
            <ItemsControl x:Name="DetailFacts" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,4,0,0">
              <Button x:Name="OnlyThisButton" Content="Only this program" Style="{StaticResource OutlineIceButton}" MinHeight="34" Margin="0,0,8,8" Click="OnOnlyThis" />
              <Button x:Name="OpenFolderButton" Content="Open file location" Style="{StaticResource GhostButton}" MinHeight="34" Margin="0,0,8,8" Click="OnOpenFolder" />
              <Button Content="Copy details" Style="{StaticResource GhostButton}" MinHeight="34" Margin="0,0,0,8" Click="OnCopy" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ContentControl>
    </Grid>
  </StackPanel>
</UserControl>
