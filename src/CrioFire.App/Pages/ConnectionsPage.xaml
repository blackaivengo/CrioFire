<UserControl x:Class="CrioFire.App.Pages.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
      <Border Style="{StaticResource SegGroup}">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="ShowConnected" Content="Connected" GroupName="Show" Style="{StaticResource SegItem}" IsChecked="True" Click="OnShow" />
          <RadioButton x:Name="ShowAll" Content="Everything, listening too" GroupName="Show" Style="{StaticResource SegItem}" Click="OnShow" />
        </StackPanel>
      </Border>
    </StackPanel>
    <ContentControl Style="{StaticResource IceCard}">
      <ListView x:Name="Table" SelectionMode="Single">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="PROGRAM" Width="230">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Program}" FontWeight="SemiBold" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding ProcessId}" />
            <GridViewColumn Header="PROTO" Width="70" DisplayMemberBinding="{Binding Protocol}" />
            <GridViewColumn Header="STATE" Width="110">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding State}" Foreground="{DynamicResource IceTextBrush}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="LOCAL" Width="220" DisplayMemberBinding="{Binding Local}" />
            <GridViewColumn Header="REMOTE" Width="240" DisplayMemberBinding="{Binding Remote}" />
          </GridView>
        </ListView.View>
      </ListView>
    </ContentControl>
  </StackPanel>
</UserControl>
