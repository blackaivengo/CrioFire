<UserControl x:Class="CrioFire.App.Pages.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <DockPanel Margin="0,0,0,20">
      <Border DockPanel.Dock="Left" Style="{StaticResource SegGroup}">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="ShowConnected" Content="Connected" GroupName="Show" Style="{StaticResource SegItem}" IsChecked="True" Click="OnShow" />
          <RadioButton x:Name="ShowAll" Content="Everything, listening too" GroupName="Show" Style="{StaticResource SegItem}" Click="OnShow" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Allow" Style="{StaticResource OutlineIceButton}" Margin="0,0,10,0" Click="OnAllow"
                ToolTip="Make an allow rule for the selected program or service" />
        <Button Content="Block" Style="{StaticResource FireButton}" Click="OnBlock"
                ToolTip="Block the selected program, or the service behind a svchost.exe connection" />
      </StackPanel>
    </DockPanel>
    <ContentControl Style="{StaticResource IceCard}">
      <ListView x:Name="Table" SelectionMode="Single">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="PROGRAM" Width="200">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Program}" FontWeight="SemiBold" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="SERVICES" Width="170">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Services}" Foreground="{DynamicResource Text2Brush}" ToolTip="{Binding Services}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="PID" Width="64" DisplayMemberBinding="{Binding ProcessId}" />
            <GridViewColumn Header="PROTO" Width="64" DisplayMemberBinding="{Binding Protocol}" />
            <GridViewColumn Header="STATE" Width="100">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding State}" Foreground="{DynamicResource IceTextBrush}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="LOCAL" Width="200" DisplayMemberBinding="{Binding Local}" />
            <GridViewColumn Header="REMOTE" Width="220" DisplayMemberBinding="{Binding Remote}" />
          </GridView>
        </ListView.View>
      </ListView>
    </ContentControl>
  </StackPanel>
</UserControl>
