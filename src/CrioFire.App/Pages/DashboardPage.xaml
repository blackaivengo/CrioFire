<UserControl x:Class="CrioFire.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="BarsPanel">
      <UniformGrid Rows="1" />
    </ItemsPanelTemplate>
    <DataTemplate x:Key="BarTemplate">
      <StackPanel VerticalAlignment="Bottom" Margin="3,0" Background="Transparent" ToolTip="{Binding Tip}">
        <Border Height="{Binding ModeHeight}" CornerRadius="3,3,1,1" Background="{DynamicResource IceBrush}" />
        <Border Height="{Binding RuleHeight}" CornerRadius="3,3,1,1" Background="{DynamicResource FireGradientBrush}" Margin="0,2,0,0" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <!-- Protection: the ring and what the current mode means. -->
    <ContentControl Style="{StaticResource HeroCard}" Margin="0,0,0,22">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="168" Height="168" Margin="0,0,32,0">
          <Ellipse Margin="6" Stroke="{DynamicResource TrackBrush}" StrokeThickness="12" />
          <Path x:Name="Ring" Stroke="{StaticResource BrandDiagonalBrush}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect>
              <DropShadowEffect Color="#B9A8FF" BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
            </Path.Effect>
          </Path>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Viewbox Width="30" Height="30">
              <Canvas Width="24" Height="24">
                <Path x:Name="ShieldIcon" Data="{StaticResource IconShieldCheck}" Stroke="{DynamicResource IceTextBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock x:Name="ProtectedText" Text="Protected" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock x:Name="ModeText" Style="{StaticResource Caption}" FontSize="12" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Headline" Style="{StaticResource H2}" FontSize="22" TextWrapping="Wrap" />
          <TextBlock x:Name="Body" Style="{StaticResource Muted}" FontSize="14" LineHeight="22" MaxWidth="640" HorizontalAlignment="Left" Margin="0,10,0,16" />
          <WrapPanel>
            <Border Style="{StaticResource Chip}" Background="{DynamicResource ChipIceBrush}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource IceBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="AutoChip" Text="Loopback and Windows services always allowed" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource ChipIceTextBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}" Background="{DynamicResource ChipIceBrush}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource IceBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="AllowChip" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource ChipIceTextBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}" Background="{DynamicResource ChipFireBrush}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource FireBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="BlockChip" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource ChipFireTextBrush}" />
              </StackPanel>
            </Border>
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="20,0,0,0">
          <TextBlock Text="Mode" Style="{StaticResource Caption}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,4,6" />
          <Border Style="{StaticResource SegGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ModeLearning" Content="Learning" Tag="learning" GroupName="Mode" Style="{StaticResource SegIceItem}" Click="OnMode" />
              <RadioButton x:Name="ModeAsk" Content="Ask" Tag="ask" GroupName="Mode" Style="{StaticResource SegFireItem}" Click="OnMode" />
              <RadioButton x:Name="ModeAllowList" Content="Allow-list" Tag="allowlist" GroupName="Mode" Style="{StaticResource SegFireItem}" Click="OnMode" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ContentControl>

    <!-- At a glance. -->
    <UniformGrid Columns="4" Margin="-8,0,-8,22">
      <ContentControl Style="{StaticResource FireCard}" Margin="8,0">
        <StackPanel>
          <DockPanel>
            <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Fill="{DynamicResource FireBrush}">
              <Ellipse.Effect><DropShadowEffect Color="#FF4A32" BlurRadius="12" ShadowDepth="0" /></Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="Blocked, last 24 h" Style="{StaticResource Muted}" />
          </DockPanel>
          <TextBlock x:Name="KpiBlocked" Style="{StaticResource BigNumber}" Foreground="{DynamicResource FireBrush}" Margin="0,8" Text="–" />
          <TextBlock x:Name="KpiBlockedNote" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
      </ContentControl>
      <ContentControl Style="{StaticResource IceCard}" Margin="8,0">
        <StackPanel>
          <DockPanel>
            <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Fill="{DynamicResource IceBrush}">
              <Ellipse.Effect><DropShadowEffect Color="#7DD8FF" BlurRadius="12" ShadowDepth="0" /></Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="Allowed, last 24 h" Style="{StaticResource Muted}" />
          </DockPanel>
          <TextBlock x:Name="KpiAllowed" Style="{StaticResource BigNumber}" Foreground="{DynamicResource IceTextBrush}" Margin="0,8" Text="–" />
          <TextBlock x:Name="KpiAllowedNote" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
      </ContentControl>
      <ContentControl Style="{StaticResource Card}" Margin="8,0">
        <StackPanel>
          <DockPanel>
            <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Fill="{DynamicResource TextBrush}" Opacity="0.8" />
            <TextBlock Text="Live connections" Style="{StaticResource Muted}" />
          </DockPanel>
          <TextBlock x:Name="KpiLive" Style="{StaticResource BigNumber}" Margin="0,8" Text="–" />
          <TextBlock x:Name="KpiLiveNote" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
      </ContentControl>
      <ContentControl Style="{StaticResource FireCard}" Margin="8,0">
        <StackPanel>
          <DockPanel>
            <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Fill="{DynamicResource FireTextBrush}">
              <Ellipse.Effect><DropShadowEffect Color="#FF8A78" BlurRadius="12" ShadowDepth="0" /></Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="Waiting for you" Style="{StaticResource Muted}" />
          </DockPanel>
          <TextBlock x:Name="KpiWaiting" Style="{StaticResource BigNumber}" Foreground="{DynamicResource FireTextBrush}" Margin="0,8" Text="0" />
          <TextBlock x:Name="KpiWaitingNote" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
      </ContentControl>
    </UniformGrid>

    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ContentControl Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource FireBrush}" />
              <TextBlock Text="Your rules" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,14,0" />
              <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource IceBrush}" />
              <TextBlock Text="No rule yet" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="Blocked, last 24 hours" Style="{StaticResource H2}" />
          </DockPanel>
          <Grid Height="200" Margin="0,20,0,0">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" />
            <ItemsControl x:Name="HourBars" ItemsPanel="{StaticResource BarsPanel}" ItemTemplate="{StaticResource BarTemplate}" Margin="0,0,0,1" />
            <TextBlock x:Name="ChartEmpty" Text="Nothing blocked in the last 24 hours." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
          <Grid Margin="0,8,0,0">
            <TextBlock x:Name="AxisStart" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
            <TextBlock x:Name="AxisMid" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            <TextBlock Text="Now" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </ContentControl>

      <ContentControl Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Blocked most" Style="{StaticResource H2}" Margin="0,0,0,14" />
          <Button DockPanel.Dock="Bottom" Content="Open reports →" Style="{StaticResource GhostButton}" Foreground="{DynamicResource IceTextBrush}"
                  HorizontalAlignment="Left" Padding="0" Click="OnOpenReports" />
          <Grid>
            <ItemsControl x:Name="TopApps">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,14" ToolTip="{Binding App}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="13" Foreground="{DynamicResource FireTextBrush}" />
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                    <Grid Height="6" Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Fill}" />
                        <ColumnDefinition Width="{Binding Rest}" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource TrackBrush}" />
                      <Border CornerRadius="3" Background="{DynamicResource FireGradientBrush}" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="TopAppsEmpty" Text="Nothing blocked yet." Style="{StaticResource Muted}" Visibility="Collapsed" />
          </Grid>
        </DockPanel>
      </ContentControl>
    </Grid>

    <!-- Everything that was allowed, automatic rules included: each one can be blocked from here. -->
    <ContentControl Style="{StaticResource IceCard}" Margin="0,0,0,22">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="See everything allowed →" Style="{StaticResource GhostButton}" Foreground="{DynamicResource IceTextBrush}"
                  Padding="0" MinHeight="24" Click="OnOpenAllowed" />
          <StackPanel>
            <TextBlock Text="Allowed most, last 24 hours" Style="{StaticResource H2}" />
            <TextBlock x:Name="AllowedNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="AllowedEmpty" Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed"
                   Text="Nothing recorded yet. The CrioFire service lists every program and service it lets through here." />
        <ItemsControl x:Name="AllowedList" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0" ToolTip="{Binding Detail}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" Background="{Binding ChipBrush}">
                    <TextBlock Text="{Binding Why}" FontSize="12" Foreground="{Binding ChipTextBrush}" />
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding CountText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                  <Grid Grid.Column="3" Height="6" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding Fill}" />
                      <ColumnDefinition Width="{Binding Rest}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource TrackBrush}" />
                    <Border CornerRadius="3" Background="{DynamicResource IceBrush}" />
                  </Grid>
                  <Button Grid.Column="4" Content="Block" Tag="{Binding}" Style="{StaticResource OutlineFireButton}" Margin="14,0,0,0" Click="OnBlockAllowed" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ContentControl>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ContentControl Style="{StaticResource FireCard}" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="Waiting for your decision" Style="{StaticResource H2}" />
          <TextBlock x:Name="PendingEmpty" Style="{StaticResource Muted}" Margin="0,12,0,0" />
          <ItemsControl x:Name="PendingList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="12" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource ChipFireBrush}" Margin="0,0,12,0">
                      <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource IconFlame}" Stroke="{DynamicResource FireTextBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding App}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                      <Button Content="Allow" Tag="{Binding App}" Style="{StaticResource IceButton}" Click="OnAllowPending" Margin="0,0,8,0" />
                      <Button Content="Block" Tag="{Binding App}" Style="{StaticResource OutlineFireButton}" Click="OnBlockPending" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>

      <ContentControl Grid.Column="1" Style="{StaticResource IceCard}" Margin="10,0,0,0">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Show all →" Style="{StaticResource GhostButton}" Foreground="{DynamicResource IceTextBrush}" Padding="0" MinHeight="24" Click="OnOpenConnections" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Live connections" Style="{StaticResource H2}" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource IceBrush}" Margin="12,3,6,0" VerticalAlignment="Center">
                <Ellipse.Effect><DropShadowEffect Color="#7DD8FF" BlurRadius="8" ShadowDepth="0" /></Ellipse.Effect>
              </Ellipse>
              <TextBlock Text="live" Foreground="{DynamicResource IceTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.3*" />
              <ColumnDefinition Width="1.6*" />
              <ColumnDefinition Width="0.5*" />
              <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROGRAM" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="REMOTE" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="PROTO" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="STATE" Style="{StaticResource Caption}" FontWeight="SemiBold" />
          </Grid>
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0" />
          <ItemsControl x:Name="LiveList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.3*" />
                      <ColumnDefinition Width="1.6*" />
                      <ColumnDefinition Width="0.5*" />
                      <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Program}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Remote}" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Protocol}" Foreground="{DynamicResource Text2Brush}" />
                    <TextBlock Grid.Column="3" Text="{Binding State}" Foreground="{DynamicResource IceTextBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>
    </Grid>
  </StackPanel>
</UserControl>
