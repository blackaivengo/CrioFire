<UserControl x:Class="CrioFire.App.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="BarsPanel">
      <UniformGrid Rows="1" />
    </ItemsPanelTemplate>

  </UserControl.Resources>

  <StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
        <Border Style="{StaticResource SegGroup}" Margin="0,0,12,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PeriodDay" Content="Last 24 hours" Tag="24h" GroupName="Period" Style="{StaticResource SegItem}" Click="OnPeriod" />
            <RadioButton x:Name="PeriodWeek" Content="Last 7 days" Tag="7d" GroupName="Period" Style="{StaticResource SegItem}" Click="OnPeriod" IsChecked="True" />
            <RadioButton x:Name="PeriodMonth" Content="Last 30 days" Tag="30d" GroupName="Period" Style="{StaticResource SegItem}" Click="OnPeriod" />
          </StackPanel>
        </Border>
        <Button Style="{StaticResource OutlineIceButton}" Margin="0,0,10,0" MinHeight="44" Click="OnExportCsv">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource IceTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Export CSV" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource FireButton}" MinHeight="44" Click="OnSavePdf">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource IconDocument}" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Save as PDF" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    <StackPanel x:Name="ReportRoot">
    <UniformGrid Columns="4" Margin="-8,0,-8,22">
      <ContentControl Style="{StaticResource FireCard}" Margin="8,0">
        <StackPanel>
          <TextBlock Text="Connections blocked" Style="{StaticResource Muted}" />
          <TextBlock x:Name="SumBlocked" Style="{StaticResource BigNumber}" FontSize="32" Foreground="{DynamicResource FireBrush}" Margin="0,8" Text="–" />
          <TextBlock x:Name="SumBlockedNote" FontSize="12" />
        </StackPanel>
      </ContentControl>
      <ContentControl Style="{StaticResource Card}" Margin="8,0">
        <StackPanel>
          <TextBlock Text="Programs blocked" Style="{StaticResource Muted}" />
          <TextBlock x:Name="SumPrograms" Style="{StaticResource BigNumber}" FontSize="32" Margin="0,8" Text="–" />
          <TextBlock x:Name="SumProgramsNote" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
      </ContentControl>
      <ContentControl Style="{StaticResource Card}" Margin="8,0">
        <StackPanel>
          <TextBlock Text="Destinations" Style="{StaticResource Muted}" />
          <TextBlock x:Name="SumDestinations" Style="{StaticResource BigNumber}" FontSize="32" Margin="0,8" Text="–" />
          <TextBlock Text="distinct addresses and ports" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
      </ContentControl>
      <ContentControl Style="{StaticResource IceCard}" Margin="8,0">
        <StackPanel>
          <TextBlock Text="Stopped by the mode" Style="{StaticResource Muted}" />
          <TextBlock x:Name="SumMode" Style="{StaticResource BigNumber}" FontSize="32" Foreground="{DynamicResource IceTextBrush}" Margin="0,8" Text="–" />
          <TextBlock Text="programs that had no rule yet" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
      </ContentControl>
    </UniformGrid>

    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,22">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource FireBrush}" />
            <TextBlock Text="Your block rules" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,14,0" />
            <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource IceBrush}" />
            <TextBlock Text="No rule yet (mode)" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0" />
          </StackPanel>
          <TextBlock x:Name="ChartTitle" Text="Blocked connections per day" Style="{StaticResource H2}" />
        </DockPanel>
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Height="240">
            <TextBlock x:Name="AxisTop" Style="{StaticResource Caption}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,18,10,0" />
            <TextBlock x:Name="AxisMid" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,18,10,0" />
            <TextBlock Text="0" Style="{StaticResource Caption}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,0" />
          </Grid>
          <Grid Grid.Column="1" Height="240">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" />
            <ItemsControl x:Name="DayBars" ItemsPanel="{StaticResource BarsPanel}" Margin="0,0,0,1">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Bottom" Margin="5,0" Background="Transparent" ToolTip="{Binding Tip}">
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <Border Height="{Binding ModeHeight}" CornerRadius="5,5,2,2" Background="{DynamicResource IceBrush}" />
                    <Border Height="{Binding RuleHeight}" CornerRadius="4,4,2,2" Background="{DynamicResource FireGradientBrush}" Margin="0,3,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ChartEmpty" Text="Nothing blocked in this period." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
          <ItemsControl x:Name="DayLabels" Grid.Column="1" Margin="0,248,0,0" ItemsPanel="{StaticResource BarsPanel}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </StackPanel>
    </ContentControl>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ContentControl Style="{StaticResource Card}" Margin="0,0,10,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Programs CrioFire blocked" Style="{StaticResource H2}" Margin="0,0,0,12" />
          <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2.2*" />
              <ColumnDefinition Width="0.7*" />
              <ColumnDefinition Width="1.4*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROGRAM" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="BLOCKED" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,14,0" />
            <TextBlock Grid.Column="2" Text="SHARE" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="WHY" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="14,0,0,0" />
            <TextBlock Grid.Column="4" Text="LAST SEEN" Style="{StaticResource Caption}" FontWeight="SemiBold" />
          </Grid>
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0" />
          <ItemsControl x:Name="ProgramList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,11">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2.2*" />
                      <ColumnDefinition Width="0.7*" />
                      <ColumnDefinition Width="1.4*" />
                      <ColumnDefinition Width="1*" />
                      <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding App}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding App}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Grid Grid.Column="2" Height="8" VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Fill}" />
                        <ColumnDefinition Width="{Binding Rest}" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{DynamicResource TrackBrush}" />
                      <Border CornerRadius="4" Background="{Binding BarBrush}" />
                    </Grid>
                    <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding ChipBrush}">
                      <TextBlock Text="{Binding Why}" FontSize="12" FontWeight="Medium" Foreground="{Binding ChipTextBrush}" />
                    </Border>
                    <TextBlock Grid.Column="4" Text="{Binding LastSeen}" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ProgramsEmpty" Text="No programs were blocked in this period." Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>
      </ContentControl>

      <StackPanel Grid.Column="1" Margin="10,0,0,0">
        <ContentControl Style="{StaticResource FireCard}" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Text="Outbound vs inbound" Style="{StaticResource H2}" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal">
              <Grid Width="132" Height="132">
                <Ellipse Margin="6" Stroke="{DynamicResource IceBrush}" StrokeThickness="16" />
                <Path x:Name="DonutArc" Stroke="{DynamicResource FireBrush}" StrokeThickness="16">
                  <Path.Effect>
                    <DropShadowEffect Color="#FF4A32" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
                  </Path.Effect>
                </Path>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="OutShare" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Text="outbound" Style="{StaticResource Caption}" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
              <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource FireBrush}" />
                  <TextBlock x:Name="OutCount" Margin="8,0,0,0" FontSize="13" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource IceBrush}" />
                  <TextBlock x:Name="InCount" Margin="8,0,0,0" FontSize="13" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource IceCard}">
          <StackPanel>
            <TextBlock Text="Top destinations" Style="{StaticResource H2}" Margin="0,0,0,8" />
            <ItemsControl x:Name="DestinationList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontWeight="SemiBold" Foreground="{DynamicResource FireTextBrush}" />
                      <TextBlock Text="{Binding Address}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Border Style="{StaticResource Chip}" Margin="10,0,10,0" Padding="8,2" HorizontalAlignment="Left" Background="{DynamicResource ChipIceBrush}">
                        <TextBlock Text="{Binding Port}" FontSize="11" Foreground="{DynamicResource ChipIceTextBrush}" />
                      </Border>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DestinationsEmpty" Text="No destinations yet." Style="{StaticResource Muted}" Visibility="Collapsed" />
          </StackPanel>
        </ContentControl>
      </StackPanel>
    </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
