<Window x:Class="CrioFire.App.DomainRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New domain rule" Width="620" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28">
    <Border Margin="40,50,40,-10" CornerRadius="20" Background="{DynamicResource IceGlowBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="44" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="28,24">
      <StackPanel>
        <TextBlock Text="New domain rule" Style="{StaticResource H2}" FontSize="20" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,20" TextWrapping="Wrap"
                   Text="Allow or block a site by name, with every name under it. CrioFire follows Windows' name lookups and applies the rule to the addresses they return." />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Action" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <Border Grid.Column="1" Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ActionBlock" Content="Block" GroupName="Action" Style="{StaticResource SegFireItem}" IsChecked="True" Click="OnChanged" />
              <RadioButton x:Name="ActionAllow" Content="Allow" GroupName="Action" Style="{StaticResource SegIceItem}" Click="OnChanged" />
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="1" Text="Domain" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,11,0,0" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
            <TextBox x:Name="DomainBox" Style="{StaticResource Field}" TextChanged="OnChanged" />
            <TextBlock Text="E.g. example.com: also covers www.example.com and every other name under it." Style="{StaticResource Caption}" FontSize="12" Margin="2,5,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock Grid.Row="2" Text="Program" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,11,0,0" />
          <StackPanel Grid.Row="2" Grid.Column="1">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineIceButton}" Margin="8,0,0,0" Click="OnBrowse" />
              <TextBox x:Name="AppBox" Style="{StaticResource Field}" TextChanged="OnChanged" />
            </DockPanel>
            <TextBlock Text="Leave empty for every program." Style="{StaticResource Caption}" FontSize="12" Margin="2,5,0,0" />
          </StackPanel>

          <TextBlock Grid.Row="3" Text="Networks" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,12,0,0" />
          <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="NetAny" Content="Every network" GroupName="Net" Style="{StaticResource SegItem}" IsChecked="True" Click="OnChanged" />
              <RadioButton x:Name="NetHomeWork" Content="Home and work" GroupName="Net" Style="{StaticResource SegItem}" Click="OnChanged"
                           ToolTip="Networks Windows calls private or domain" />
              <RadioButton x:Name="NetPublic" Content="Public networks" GroupName="Net" Style="{StaticResource SegItem}" Click="OnChanged"
                           ToolTip="Cafés, hotels, airports, and networks Windows does not know" />
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="PreviewBox" CornerRadius="10" Padding="14,10" Margin="0,18,0,0" Background="{DynamicResource ChipIceBrush}">
          <TextBlock x:Name="PreviewText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource ChipIceTextBrush}" />
        </Border>
        <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"
                   Text="Good to know: sites that share an address with this domain (common on big hosting services) are affected too, and a browser using its own secure DNS can get past it." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
          <Button x:Name="SaveButton" Content="Add rule" Style="{StaticResource FireButton}" IsDefault="True" Click="OnSave" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Height="2" VerticalAlignment="Top" Margin="16,1,16,0" CornerRadius="1" Background="{StaticResource BrandBrush}" />
  </Grid>
</Window>
