<Window x:Class="CrioFire.App.PanicDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panic" Width="600" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28">
    <Border Margin="40,50,40,-10" CornerRadius="20" Background="{DynamicResource FireGlowBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="44" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="28,24">
      <StackPanel>
        <TextBlock x:Name="TitleText" Text="Panic" Style="{StaticResource H2}" FontSize="20" />
        <TextBlock x:Name="IntroText" Style="{StaticResource Muted}" Margin="0,6,0,16" TextWrapping="Wrap" LineHeight="20" />
        <StackPanel x:Name="Options" />
        <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" IsCancel="True" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <Border Height="2" VerticalAlignment="Top" Margin="16,1,16,0" CornerRadius="1" Background="{StaticResource BrandBrush}" />
  </Grid>
</Window>
