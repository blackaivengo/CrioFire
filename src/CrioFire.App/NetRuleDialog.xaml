<Window x:Class="CrioFire.App.NetRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New network rule" Width="620" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28">
    <Border Margin="40,50,40,-10" CornerRadius="20" Background="{DynamicResource IceGlowBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="44" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="28,24">
      <StackPanel>
        <TextBlock Text="New network rule" Style="{StaticResource H2}" FontSize="20" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,20"
                   Text="Allow or block by port and remote address, for every program or just one. More specific rules win, and block wins a tie." />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Action" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <Border Grid.Column="1" Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ActionBlock" Content="Block" GroupName="Action" Style="{StaticResource SegFireItem}" IsChecked="True" Click="OnChanged" />
              <RadioButton x:Name="ActionAllow" Content="Allow" GroupName="Action" Style="{StaticResource SegIceItem}" Click="OnChanged" />
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="1" Text="Direction" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="DirOut" Content="Outbound" GroupName="Dir" Style="{StaticResource SegItem}" IsChecked="True" Click="OnChanged" />
              <RadioButton x:Name="DirIn" Content="Inbound" GroupName="Dir" Style="{StaticResource SegItem}" Click="OnChanged" />
              <RadioButton x:Name="DirBoth" Content="Both" GroupName="Dir" Style="{StaticResource SegItem}" Click="OnChanged" />
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="2" Text="Protocol" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ProtoAny" Content="Any" GroupName="Proto" Style="{StaticResource SegItem}" IsChecked="True" Click="OnChanged" />
              <RadioButton x:Name="ProtoTcp" Content="TCP" GroupName="Proto" Style="{StaticResource SegItem}" Click="OnChanged" />
              <RadioButton x:Name="ProtoUdp" Content="UDP" GroupName="Proto" Style="{StaticResource SegItem}" Click="OnChanged" />
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="3" x:Name="PortsLabel" Text="Ports" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,11,0,0" />
          <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
            <TextBox x:Name="PortsBox" Style="{StaticResource Field}" TextChanged="OnChanged" />
            <TextBlock x:Name="PortsHint" Style="{StaticResource Caption}" FontSize="12" Margin="2,5,0,0" />
          </StackPanel>

          <TextBlock Grid.Row="4" Text="Remote addresses" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,11,8,0" />
          <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
            <TextBox x:Name="AddressesBox" Style="{StaticResource Field}" TextChanged="OnChanged" />
            <TextBlock Text="Leave empty for any. E.g. 203.0.113.5, 10.0.0.0/8, 10.0.0.1-10.0.0.50 or 2001:db8::/32" Style="{StaticResource Caption}" FontSize="12" Margin="2,5,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock Grid.Row="5" Text="Program" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,11,0,0" />
          <StackPanel Grid.Row="5" Grid.Column="1">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineIceButton}" Margin="8,0,0,0" Click="OnBrowse" />
              <TextBox x:Name="AppBox" Style="{StaticResource Field}" TextChanged="OnChanged" />
            </DockPanel>
            <TextBlock Text="Leave empty for every program." Style="{StaticResource Caption}" FontSize="12" Margin="2,5,0,0" />
          </StackPanel>
        </Grid>

        <Border x:Name="PreviewBox" CornerRadius="10" Padding="14,10" Margin="0,18,0,0" Background="{DynamicResource ChipIceBrush}">
          <TextBlock x:Name="PreviewText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource ChipIceTextBrush}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
          <Button x:Name="SaveButton" Content="Add rule" Style="{StaticResource FireButton}" IsDefault="True" Click="OnSave" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Height="2" VerticalAlignment="Top" Margin="16,1,16,0" CornerRadius="1" Background="{StaticResource BrandBrush}" />
  </Grid>
</Window>
