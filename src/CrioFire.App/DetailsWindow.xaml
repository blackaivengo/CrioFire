<Window x:Class="CrioFire.App.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Details" Width="580" SizeToContent="Height" MaxHeight="760" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28">
    <Border Margin="40,50,40,-10" CornerRadius="20" Background="{DynamicResource IceGlowBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="44" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="28,24">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap" />
          <TextBlock x:Name="PathText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14" />
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button x:Name="AllowButton" Content="Allow" Style="{StaticResource IceButton}" Margin="8,4,0,0" Click="OnAllow" />
          <Button x:Name="BlockButton" Content="Block" Style="{StaticResource OutlineFireButton}" Margin="8,4,0,0" Click="OnBlock" />
          <Button x:Name="FolderButton" Content="Open file location" Style="{StaticResource GhostButton}" Margin="8,4,0,0" Click="OnFolder" />
          <Button Content="Copy" Style="{StaticResource GhostButton}" Margin="8,4,0,0" Click="OnCopy" />
          <Button Content="Close" Style="{StaticResource GhostButton}" Margin="8,4,0,0" IsCancel="True" />
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="Facts">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border Height="2" VerticalAlignment="Top" Margin="16,1,16,0" CornerRadius="1" Background="{StaticResource BrandBrush}" />
  </Grid>
</Window>
