<Window x:Class="CrioFire.App.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrioFire: a program wants to connect" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual">
  <StackPanel Margin="18">
    <TextBlock x:Name="ProgramName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="was blocked because it has no rule yet." Margin="0,2,0,10" />
    <TextBlock x:Name="ProgramPath" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
    <TextBlock x:Name="Details" TextWrapping="Wrap" Margin="0,0,0,14" />
    <TextBlock Text="It can try again once you decide." Foreground="Gray" Margin="0,0,0,12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Allow" Width="80" IsDefault="True" Click="OnAllow" />
      <Button Content="Allow for 1 hour" Width="110" Margin="8,0,0,0" Click="OnAllowOneHour" />
      <Button Content="Block" Width="80" Margin="8,0,0,0" Click="OnBlock" />
    </StackPanel>
  </StackPanel>
</Window>
