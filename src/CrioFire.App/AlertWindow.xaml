<Window x:Class="CrioFire.App.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrioFire: a program wants to connect" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual" ShowActivated="False"
        FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28">
    <Border Margin="40,50,40,-10" CornerRadius="20" Background="{DynamicResource FireGlowBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="44" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="22,18,22,22">
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,0" MinHeight="32" ToolTip="Not now" Click="OnNotNow" AutomationProperties.Name="Not now">
            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Text2Brush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
          </Button>
          <Viewbox Width="18" Height="18" VerticalAlignment="Center">
            <Canvas Width="40" Height="40">
              <Path Data="{StaticResource LogoFlame}" Fill="{StaticResource BrandBrush}" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="CRIOFIRE · ASK MODE" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Foreground="{DynamicResource Text2Brush}" FontSize="12" />
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top">
            <Border CornerRadius="12" Margin="4,8,4,-2" Background="{DynamicResource FireGlowBrush}" IsHitTestVisible="False">
              <Border.Effect>
                <BlurEffect Radius="16" />
              </Border.Effect>
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource ChipFireBrush}">
              <Viewbox Width="24" Height="24">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconFlame}" Stroke="{DynamicResource FireTextBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="Headline" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" />
            <TextBlock Text="Blocked for now, because it has no rule yet." Style="{StaticResource Muted}" Margin="0,3,0,3" />
            <TextBlock x:Name="Details" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <UniformGrid Rows="1" Margin="0,18,0,0">
          <Button Content="Allow" Style="{StaticResource IceButton}" Margin="0,0,6,0" MinHeight="44" Click="OnAllow" />
          <Button Content="Allow 1 hour" Style="{StaticResource OutlineIceButton}" Margin="3,0" MinHeight="44" Click="OnAllowOneHour" />
          <Button Content="Block" Style="{StaticResource FireButton}" Margin="6,0,0,0" MinHeight="44" Click="OnBlock" />
        </UniformGrid>
      </StackPanel>
    </Border>
    <Border Height="3" VerticalAlignment="Top" Margin="16,1,16,0" CornerRadius="1.5" Background="{StaticResource BrandBrush}" />
  </Grid>
</Window>
