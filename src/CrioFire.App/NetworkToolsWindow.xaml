<Window x:Class="CrioFire.App.NetworkToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network tools" Width="820" Height="680" MinWidth="620" MinHeight="460" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}">
  <!-- Checks on a connection's remote address (ping, trace route, name, connections, a port) and terminals to it. -->
  <Grid Margin="20">
    <Border CornerRadius="16" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="26,22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,0" MinHeight="32" ToolTip="Close" Click="OnClose" AutomationProperties.Name="Close">
              <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Text2Brush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
            </Button>
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14" />

          <TextBlock Text="Check" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,6" />
          <WrapPanel>
            <Button Content="Ping" Style="{StaticResource OutlineIceButton}" Margin="0,0,8,8" MinHeight="36" Click="OnPing"
                    ToolTip="Sends four echo requests and shows whether and how fast it answers." />
            <Button Content="Trace route" Style="{StaticResource OutlineIceButton}" Margin="0,0,8,8" MinHeight="36" Click="OnTraceRoute"
                    ToolTip="Lists every router between this PC and the address (tracert)." />
            <Button Content="Name lookup" Style="{StaticResource OutlineIceButton}" Margin="0,0,8,8" MinHeight="36" Click="OnNameLookup"
                    ToolTip="Asks your DNS server for the address's name (nslookup)." />
            <Button Content="Connections" Style="{StaticResource OutlineIceButton}" Margin="0,0,8,8" MinHeight="36" Click="OnConnections"
                    ToolTip="Every open connection between this PC and the address, with the program (netstat)." />
            <Button x:Name="OwnerButton" Content="Who owns it" Style="{StaticResource OutlineIceButton}" Margin="0,0,8,8" MinHeight="36" Click="OnOwner"
                    ToolTip="Opens ipinfo.io: the network, company and country the address belongs to." />
            <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
              <TextBlock Text="Port" VerticalAlignment="Center" Margin="4,0,8,0" Style="{StaticResource Muted}" />
              <TextBox x:Name="PortBox" Width="72" VerticalContentAlignment="Center" MaxLength="5" AutomationProperties.Name="Port" TextChanged="OnPortChanged" />
              <Button x:Name="TestPortButton" Content="Test port" Style="{StaticResource OutlineIceButton}" Margin="8,0,0,0" MinHeight="36" Click="OnTestPort"
                      ToolTip="Tries to open a TCP connection to the port, for up to 5 seconds." />
            </StackPanel>
          </WrapPanel>

          <TextBlock Text="Open a terminal" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,8,0,6" />
          <WrapPanel>
            <Button x:Name="SshButton" Content="SSH" Style="{StaticResource GhostButton}" Margin="0,0,8,8" MinHeight="36" Click="OnSsh"
                    ToolTip="Opens an SSH session to the address in a new window (port 22)." />
            <Button x:Name="RdpButton" Content="Remote Desktop" Style="{StaticResource GhostButton}" Margin="0,0,8,8" MinHeight="36" Click="OnRemoteDesktop"
                    ToolTip="Opens Remote Desktop Connection to the address (port 3389)." />
            <Button x:Name="TelnetButton" Content="Telnet to the port" Style="{StaticResource GhostButton}" Margin="0,0,8,8" MinHeight="36" Click="OnTelnet"
                    ToolTip="Opens a raw TCP session to the port in a new window." />
            <Button x:Name="PowerShellButton" Content="PowerShell connection test" Style="{StaticResource GhostButton}" Margin="0,0,8,8" MinHeight="36" Click="OnPowerShell"
                    ToolTip="Opens PowerShell with Test-NetConnection to the address and port, and leaves it open for more." />
          </WrapPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="StopButton" Content="Stop" Style="{StaticResource OutlineFireButton}" Margin="8,0,0,0" IsEnabled="False" Click="OnStop" />
            <Button Content="Copy" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCopy" />
            <Button Content="Close" Style="{StaticResource GhostButton}" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
          </StackPanel>
          <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="These tools connect from this PC. In Ask or Allow-list mode, CrioFire may ask about them or block them like any other program." />

        <Border CornerRadius="10" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,6,0,0">
          <TextBox x:Name="Output" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource TextBrush}" Padding="12,10" AcceptsReturn="True" AutomationProperties.Name="Output" />
        </Border>
      </DockPanel>
    </Border>
  </Grid>
</Window>
