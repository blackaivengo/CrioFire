<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- CrioFire light theme: icy white, deeper ice blue and fire red so text stays readable. -->
  <SolidColorBrush x:Key="BgBrush" Color="#E9F1F9" />
  <RadialGradientBrush x:Key="BlobIceBrush">
    <GradientStop Color="#8C7DD8FF" Offset="0" />
    <GradientStop Color="#007DD8FF" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="BlobFireBrush">
    <GradientStop Color="#47FF6E50" Offset="0" />
    <GradientStop Color="#00FF6E50" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="NavBrush" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="NavBorderBrush" Color="#386E8CB4" />
  <SolidColorBrush x:Key="CardBrush" Color="#9EFFFFFF" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#D9FFFFFF" />
  <SolidColorBrush x:Key="CardSolidBrush" Color="#F7FFFFFF" />
  <SolidColorBrush x:Key="InsetBrush" Color="#A6FFFFFF" />
  <SolidColorBrush x:Key="SegBrush" Color="#99FFFFFF" />

  <SolidColorBrush x:Key="TextBrush" Color="#0E1A2B" />
  <SolidColorBrush x:Key="Text2Brush" Color="#4D5F78" />
  <SolidColorBrush x:Key="Text3Brush" Color="#5E6F87" />
  <SolidColorBrush x:Key="NavTextBrush" Color="#3F516A" />
  <SolidColorBrush x:Key="LineBrush" Color="#1A1E3C64" />
  <SolidColorBrush x:Key="TrackBrush" Color="#1A1E3C64" />

  <SolidColorBrush x:Key="IceBrush" Color="#5CC8F7" />
  <SolidColorBrush x:Key="IceTextBrush" Color="#0874B3" />
  <SolidColorBrush x:Key="IceInkBrush" Color="#06233A" />
  <SolidColorBrush x:Key="FireBrush" Color="#E5341F" />
  <SolidColorBrush x:Key="FireTextBrush" Color="#C42A17" />
  <LinearGradientBrush x:Key="FireGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF6A50" Offset="0" />
    <GradientStop Color="#E5341F" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ChipIceBrush" Color="#293CB4F0" />
  <SolidColorBrush x:Key="ChipIceTextBrush" Color="#075F93" />
  <SolidColorBrush x:Key="ChipFireBrush" Color="#1AE5341F" />
  <SolidColorBrush x:Key="ChipFireTextBrush" Color="#B02714" />

  <SolidColorBrush x:Key="NavActiveBrush" Color="#293CB4F0" />
  <SolidColorBrush x:Key="NavHoverBrush" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="SelectedRowBrush" Color="#293CB4F0" />
  <SolidColorBrush x:Key="SegOnBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SegOnTextBrush" Color="#0E1A2B" />
  <SolidColorBrush x:Key="OutlineFireBrush" Color="#73E5341F" />
  <SolidColorBrush x:Key="PanicBgBrush" Color="#14E5341F" />
  <SolidColorBrush x:Key="OutlineIceBrush" Color="#4D0874B3" />
  <SolidColorBrush x:Key="OutlineIceBgBrush" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#401E3C64" />

  <SolidColorBrush x:Key="IceGlowBrush" Color="#731E96DC" />
  <SolidColorBrush x:Key="FireGlowBrush" Color="#66E5341F" />
  <SolidColorBrush x:Key="VioletGlowBrush" Color="#667864E6" />
  <SolidColorBrush x:Key="ShadowGlowBrush" Color="#4D1E3C64" />
</ResourceDictionary>
