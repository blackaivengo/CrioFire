<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- CrioFire dark theme: night navy, ice blue = allowed/safe, fire red = blocked. -->
  <SolidColorBrush x:Key="BgBrush" Color="#070C16" />
  <RadialGradientBrush x:Key="BlobIceBrush">
    <GradientStop Color="#337DD8FF" Offset="0" />
    <GradientStop Color="#007DD8FF" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="BlobFireBrush">
    <GradientStop Color="#29FF4A32" Offset="0" />
    <GradientStop Color="#00FF4A32" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="NavBrush" Color="#8C0A1220" />
  <SolidColorBrush x:Key="NavBorderBrush" Color="#1F7DAAE6" />
  <SolidColorBrush x:Key="CardBrush" Color="#94111C2F" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#247DAAE6" />
  <SolidColorBrush x:Key="CardSolidBrush" Color="#F20F1A2B" />
  <SolidColorBrush x:Key="InsetBrush" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="SegBrush" Color="#8C080E1A" />

  <SolidColorBrush x:Key="TextBrush" Color="#E6EDF7" />
  <SolidColorBrush x:Key="Text2Brush" Color="#93A3BB" />
  <SolidColorBrush x:Key="Text3Brush" Color="#73839C" />
  <SolidColorBrush x:Key="NavTextBrush" Color="#A9B6CA" />
  <SolidColorBrush x:Key="LineBrush" Color="#1F7DAAE6" />
  <SolidColorBrush x:Key="TrackBrush" Color="#1F7DAAE6" />

  <SolidColorBrush x:Key="IceBrush" Color="#7DD8FF" />
  <SolidColorBrush x:Key="IceTextBrush" Color="#9FE2FF" />
  <SolidColorBrush x:Key="IceInkBrush" Color="#06233A" />
  <SolidColorBrush x:Key="FireBrush" Color="#FF4A32" />
  <SolidColorBrush x:Key="FireTextBrush" Color="#FF8A78" />
  <LinearGradientBrush x:Key="FireGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF6A50" Offset="0" />
    <GradientStop Color="#FF4A32" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ChipIceBrush" Color="#1F7DD8FF" />
  <SolidColorBrush x:Key="ChipIceTextBrush" Color="#9FE2FF" />
  <SolidColorBrush x:Key="ChipFireBrush" Color="#24FF4A32" />
  <SolidColorBrush x:Key="ChipFireTextBrush" Color="#FFB1A4" />

  <SolidColorBrush x:Key="NavActiveBrush" Color="#1F7DD8FF" />
  <SolidColorBrush x:Key="NavHoverBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SelectedRowBrush" Color="#1F7DD8FF" />
  <SolidColorBrush x:Key="SegOnBrush" Color="#297DD8FF" />
  <SolidColorBrush x:Key="SegOnTextBrush" Color="#E6EDF7" />
  <SolidColorBrush x:Key="FieldBorderBrush" Color="#247DAAE6" />
  <SolidColorBrush x:Key="SegOnBorderBrush" Color="#4D7DD8FF" />
  <SolidColorBrush x:Key="OutlineFireBrush" Color="#73FF4A32" />
  <SolidColorBrush x:Key="PanicBgBrush" Color="#1AFF4A32" />
  <SolidColorBrush x:Key="OutlineIceBrush" Color="#597DD8FF" />
  <SolidColorBrush x:Key="OutlineIceBgBrush" Color="#147DD8FF" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#407DAAE6" />

  <!-- Soft light under panels: blurred, so they read as a glow. -->
  <SolidColorBrush x:Key="IceGlowBrush" Color="#667DD8FF" />
  <SolidColorBrush x:Key="FireGlowBrush" Color="#66FF4A32" />
  <SolidColorBrush x:Key="VioletGlowBrush" Color="#73B9A8FF" />
  <SolidColorBrush x:Key="ShadowGlowBrush" Color="#99000000" />
</ResourceDictionary>
