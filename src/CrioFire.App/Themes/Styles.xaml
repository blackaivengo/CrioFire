<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared look for both themes. Colors come from Dark.xaml / Light.xaml through DynamicResource,
       so switching theme restyles everything live. -->

  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
  <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

  <!-- Where ice meets fire: used only on the logo, the protection ring and the top edge of key panels. -->
  <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#7DD8FF" Offset="0" />
    <GradientStop Color="#B9A8FF" Offset="0.5" />
    <GradientStop Color="#FF4A32" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandDiagonalBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#7DD8FF" Offset="0" />
    <GradientStop Color="#B9A8FF" Offset="0.55" />
    <GradientStop Color="#FF4A32" Offset="1" />
  </LinearGradientBrush>

  <!-- Icons: 24x24 stroke paths. -->
  <Geometry x:Key="IconDashboard">M3,3 H10 V12 H3 Z M14,3 H21 V8 H14 Z M14,12 H21 V21 H14 Z M3,16 H10 V21 H3 Z</Geometry>
  <Geometry x:Key="IconActivity">M3,12 H7 L10,20 L14,4 L17,12 H21</Geometry>
  <Geometry x:Key="IconRules">M12,3 L20,6 V12 C20,17 16.5,20 12,21 C7.5,20 4,17 4,12 V6 Z</Geometry>
  <Geometry x:Key="IconConnections">M8.5,12 A2.5,2.5 0 1 1 3.5,12 A2.5,2.5 0 1 1 8.5,12 M20.5,6 A2.5,2.5 0 1 1 15.5,6 A2.5,2.5 0 1 1 20.5,6 M20.5,18 A2.5,2.5 0 1 1 15.5,18 A2.5,2.5 0 1 1 20.5,18 M8.3,11 L15.7,7 M8.3,13 L15.7,17</Geometry>
  <Geometry x:Key="IconReports">M4,20 V10 M10,20 V4 M16,20 V13 M22,20 H2</Geometry>
  <Geometry x:Key="IconSettings">M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9</Geometry>
  <Geometry x:Key="IconSun">M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 M12,2 V4 M12,20 V22 M2,12 H4 M20,12 H22 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M4.9,19.1 L6.3,17.7 M17.7,6.3 L19.1,4.9</Geometry>
  <Geometry x:Key="IconMoon">M20,14.5 A8,8 0 0 1 9.5,4 A8,8 0 1 0 20,14.5 Z</Geometry>
  <Geometry x:Key="IconShieldCheck">M12,3 L20,6 V12 C20,17 16.5,20 12,21 C7.5,20 4,17 4,12 V6 Z M8.5,12 L11,14.5 L15.5,9.5</Geometry>
  <Geometry x:Key="IconFlame">M12,3 C13.5,7 18,9 18,15 A6,6 0 0 1 6,15 C6,12 7.5,10 9,9 C9,11 10,12 11,13 C11,9 11,6 12,3 Z</Geometry>
  <Geometry x:Key="IconDownload">M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19</Geometry>
  <Geometry x:Key="IconDocument">M6,3 H15 L19,7 V21 H6 Z M14,3 V8 H19</Geometry>
  <Geometry x:Key="LogoFlame">M20,3 C22,9 29,12 29,21 A9,9 0 0 1 11,21 C11,17 13,14 15,12 C15,15 16,17 18,18 C17,12 18,7 20,3 Z</Geometry>

  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="BigNumber" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Glass panel with a soft glow underneath. Tag = the glow's brush. -->
  <Style x:Key="Card" TargetType="ContentControl">
    <Setter Property="Padding" Value="22" />
    <Setter Property="Tag" Value="{DynamicResource ShadowGlowBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border Margin="26,36,26,-12" CornerRadius="20" Background="{TemplateBinding Tag}" IsHitTestVisible="False">
              <Border.Effect>
                <BlurEffect Radius="40" />
              </Border.Effect>
            </Border>
            <Border CornerRadius="16" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IceCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
    <Setter Property="Tag" Value="{DynamicResource IceGlowBrush}" />
  </Style>
  <Style x:Key="FireCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
    <Setter Property="Tag" Value="{DynamicResource FireGlowBrush}" />
  </Style>

  <!-- The protection panel: violet glow where ice meets fire, and the brand line along its top edge. -->
  <Style x:Key="HeroCard" TargetType="ContentControl">
    <Setter Property="Padding" Value="30,26" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border Margin="40,40,40,-16" CornerRadius="24" Background="{DynamicResource VioletGlowBrush}" IsHitTestVisible="False">
              <Border.Effect>
                <BlurEffect Radius="56" />
              </Border.Effect>
            </Border>
            <Border CornerRadius="20" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" ClipToBounds="True">
              <ContentPresenter />
            </Border>
            <Border Height="2" VerticalAlignment="Top" Margin="16,1,16,0" CornerRadius="1" Background="{StaticResource BrandBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>

  <!-- Sidebar navigation. Tag = icon geometry. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="GroupName" Value="Nav" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="glow" CornerRadius="10" Margin="12,8" Background="{DynamicResource IceGlowBrush}" Opacity="0" IsHitTestVisible="False">
              <Border.Effect>
                <BlurEffect Radius="20" />
              </Border.Effect>
            </Border>
            <Border x:Name="bd" CornerRadius="10" Background="Transparent" Padding="14,11">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Canvas>
                </Viewbox>
                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border x:Name="accent" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="2" Background="{DynamicResource IceBrush}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavActiveBrush}" />
              <Setter TargetName="accent" Property="Visibility" Value="Visible" />
              <Setter TargetName="glow" Property="Opacity" Value="0.6" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control: a SegGroup border holding SegItem radio buttons. Background/Foreground = the "on" colors. -->
  <Style x:Key="SegGroup" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SegBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="SegItem" TargetType="RadioButton">
    <Setter Property="Background" Value="{DynamicResource SegOnBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SegOnTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="glow" CornerRadius="9" Margin="6,10,6,-4" Background="{TemplateBinding Background}" Opacity="0" IsHitTestVisible="False">
              <Border.Effect>
                <BlurEffect Radius="14" />
              </Border.Effect>
            </Border>
            <Border x:Name="bd" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                    BorderBrush="Transparent" BorderThickness="1" TextElement.Foreground="{DynamicResource NavTextBrush}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="bd" Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SegOnBorderBrush}" />
              <Setter TargetName="glow" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegIceItem" TargetType="RadioButton" BasedOn="{StaticResource SegItem}">
    <Setter Property="Background" Value="{DynamicResource IceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}" />
  </Style>
  <Style x:Key="SegFireItem" TargetType="RadioButton" BasedOn="{StaticResource SegItem}">
    <Setter Property="Background" Value="{DynamicResource FireBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Buttons. Filled ones glow in their own color. -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="root">
            <Border CornerRadius="10" Margin="8,12,8,-4" Background="{TemplateBinding Background}" Opacity="0.5" IsHitTestVisible="False">
              <Border.Effect>
                <BlurEffect Radius="16" />
              </Border.Effect>
            </Border>
            <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.72" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IceButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource IceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}" />
  </Style>
  <Style x:Key="FireButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource FireBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style x:Key="OutlineFireButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource PanicBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineFireBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource FireTextBrush}" />
  </Style>
  <Style x:Key="OutlineIceButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource OutlineIceBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineIceBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource IceTextBrush}" />
  </Style>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>


  <!-- On/off switch for settings. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Top" Margin="0,1,0,0">
              <Border x:Name="glow" CornerRadius="12" Margin="4,8,4,-4" Background="{DynamicResource IceGlowBrush}" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                  <BlurEffect Radius="12" />
                </Border.Effect>
              </Border>
              <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Ellipse x:Name="thumb" Width="18" Height="18" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Text2Brush}" />
              </Border>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource IceBrush}" />
              <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource IceInkBrush}" />
              <Setter TargetName="glow" Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource IceTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- Text fields. -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource IceBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="9" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource IceTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lists and tables. -->
  <Style TargetType="ListView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="7,9" Background="Transparent">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9" CornerRadius="6">
            <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim scroll bars. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="4" Background="{DynamicResource ScrollThumbBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Margin="2">
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False" Margin="2">
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A chip you can click: the Allow/Block chips on the Rules page, blocked ports and addresses. -->
  <Style x:Key="ChipButton" TargetType="Button">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  BorderBrush="{TemplateBinding Foreground}" BorderThickness="0">
            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.75" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Right-click menus on rows: themed, rounded, flat (no submenus). -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="4" Margin="0,0,10,10" MinWidth="220">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="12,7">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="10,4" Background="{DynamicResource LineBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
