<Window x:Class="CrioFire.App.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28">
    <Border Margin="30,40,30,-14" CornerRadius="20" Background="{DynamicResource ShadowGlowBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="40" />
      </Border.Effect>
    </Border>
    <Border x:Name="Glow" Margin="40,50,40,-10" CornerRadius="20" Background="{DynamicResource IceGlowBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="44" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="26,24">
      <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" FontSize="14" LineHeight="21" Margin="0,10,0,22" TextWrapping="Wrap" />
        <!-- One row: the dialog widens to fit its answers (see the code-behind). -->
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>
    <Border Height="2" VerticalAlignment="Top" Margin="16,1,16,0" CornerRadius="1" Background="{StaticResource BrandBrush}" />
  </Grid>
</Window>
