<Window x:Class="CrioFire.App.ConfirmModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keep the new mode?" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="18">
    <TextBlock Text="Is your network still working?" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Check that the programs you need can still connect. If you don't answer, CrioFire switches back automatically." />
    <TextBlock x:Name="CountdownText" Foreground="Gray" Margin="0,0,0,14" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Keep it" Width="90" IsDefault="True" Click="OnKeep" />
      <Button Content="Switch back" Width="90" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
