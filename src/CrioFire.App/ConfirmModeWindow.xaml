<Window x:Class="CrioFire.App.ConfirmModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keep the new mode?" Width="480" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28">
    <Border Margin="40,50,40,-10" CornerRadius="20" Background="{DynamicResource VioletGlowBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="44" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="{DynamicResource CardSolidBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="26,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Top">
          <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="5" />
          <Path x:Name="CountdownArc" Stroke="{StaticResource BrandDiagonalBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <TextBlock x:Name="SecondsText" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" />
        </Grid>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Is your network still working?" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Muted}" FontSize="14" LineHeight="21" Margin="0,8,0,20"
                     Text="Check that the programs you need can still connect. If you don't answer, CrioFire switches back automatically." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Switch back" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Keep it" Style="{StaticResource IceButton}" IsDefault="True" Click="OnKeep" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Border Height="2" VerticalAlignment="Top" Margin="16,1,16,0" CornerRadius="1" Background="{StaticResource BrandBrush}" />
  </Grid>
</Window>
