<Project Sdk="Microsoft.NET.Sdk">

  <!-- CrioSoft's internal tool for creating its signing key and issuing business license keys.
       Not shipped with CrioFire. See docs/LICENSE-KEYS.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CrioFire.LicenseTool</RootNamespace>
    <AssemblyName>criofire-license</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrioFire.Core\CrioFire.Core.csproj" />
  </ItemGroup>

</Project>
